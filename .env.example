# Copy to .env (never commit real values). See docs/AI_PROVIDERS.md.
# Web/mobile clients read ONLY the two public Supabase vars (apps/web/.env.example, apps/mobile).

# --- Public (safe for clients; anon key is public by design, protected by RLS) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- SERVER ONLY: Supabase Edge Function secrets (never prefix NEXT_PUBLIC_/EXPO_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ALLOWED_ORIGIN=https://your-web-origin.example
WORKER_SECRET=long-random-string

# --- AI provider (server only). Leave AI_API_KEY empty to run without AI: calls return "not configured". ---
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_SMALL=
AI_MODEL_STANDARD=
AI_MODEL_PREMIUM=
AI_EMBED_MODEL=
AI_EMBED_DIMENSIONS=1536
EMBED_API_KEY=
EMBED_BASE_URL=
TESSERACT_LANG_PATH=
