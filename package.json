{
  "name": "unimate",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm install --prefix tools/lint --no-audit --no-fund --silent && node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.mjs .",
    "build": "npm run build --workspaces --if-present",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "lint:install": "npm ci --prefix tools/lint --no-audit --no-fund",
    "perf": "vitest run -c vitest.perf.config.mts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
